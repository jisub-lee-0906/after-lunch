{
  "name": "after-lunch-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:reset": "node ./scripts/dev-reset.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:runtime": "node --import tsx --test tests/recommendation_runtime_behavior.test.ts",
