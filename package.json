  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "lucide-react": "^1.11.0",
    "next": "16.3.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "8.5.23",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
